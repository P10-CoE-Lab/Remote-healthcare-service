# ── Alert notifications ───────────────────────────────────────────────────────
# Email address that receives health alerts. Leave blank to disable email alerts.
ALERT_EMAIL=you@example.com
ALERT_EMAIL_NAME=Healthcare Monitoring Team

# Minimum seconds between emails for the same patient + rule (prevents flooding)
ALERT_COOLDOWN_SECONDS=120

# URL of the running Notification Service
NOTIFICATION_SERVICE_URL=http://localhost:8001

# ── MQTT ─────────────────────────────────────────────────────────────────────
MQTT_HOST=localhost
MQTT_PORT=1883

# ── InfluxDB ─────────────────────────────────────────────────────────────────
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=my-token
INFLUXDB_ORG=iot_org
INFLUXDB_BUCKET=iot_poc

# ── LLM (Feature 2 — Clinical Summaries) ────────────────────────────────────
# Provider: mock | anthropic | openai | gemini   (mock works without any API key)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_FAST_MODEL=      # optional — provider default used if blank
LLM_QUALITY_MODEL=   # optional — provider default used if blank
