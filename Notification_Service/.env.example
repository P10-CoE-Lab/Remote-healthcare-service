# ── Email: Gmail (App Password — active) ──────────────────────────────────────
# Generate an app password at: Google Account → Security → 2-Step Verification → App passwords
# Use this with the active GmailProvider implementation in providers/email/gmail.py
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# ── Email: Gmail (OAuth2 — commented out) ─────────────────────────────────────
# Use these if you switch back to the OAuth2 + Gmail REST API implementation.
# See providers/email/gmail.py for switching instructions.
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# GMAIL_SENDER=

# ── Email: Outlook / Microsoft 365 ────────────────────────────────────────────
# App registration in Azure Active Directory
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
# Azure AD tenant ID (find in Azure Portal → Azure Active Directory → Overview)
OUTLOOK_TENANT_ID=
# The mailbox address used as the sender
OUTLOOK_SENDER=

# ── Email: Mailhog (local dev SMTP) ───────────────────────────────────────────
# Docker Compose service name (or hostname) for the Mailhog container
MAILHOG_HOST=mailhog
# SMTP port exposed by Mailhog (default 1025)
MAILHOG_PORT=1025

# ── SMS: Twilio ────────────────────────────────────────────────────────────────
# Account SID from Twilio Console → Dashboard
TWILIO_ACCOUNT_SID=
# Auth token from Twilio Console → Dashboard
TWILIO_AUTH_TOKEN=
# Twilio phone number to send from, E.164 format e.g. +15005550006
TWILIO_FROM_NUMBER=

# ── SMS: AWS SNS ──────────────────────────────────────────────────────────────
# IAM user/role credentials with sns:Publish permission
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS region where SNS is available e.g. us-east-1
AWS_REGION=us-east-1

# ── Webhook: Slack ─────────────────────────────────────────────────────────────
# Incoming Webhook URL from Slack App configuration
SLACK_WEBHOOK_URL=

# ── Service ───────────────────────────────────────────────────────────────────
# Path to the YAML runtime config file
NOTIFICATION_CONFIG_PATH=./notification-config.yaml
# Directory containing Jinja2 template files
TEMPLATE_DIR=./templates
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Path to the append-only dead-letter JSONL file
DEAD_LETTER_PATH=./logs/dead_letter.jsonl
