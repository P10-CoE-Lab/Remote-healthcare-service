{
  "title": "Healthcare — Patient Detail",
  "uid": "healthcare-detail",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-10m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "device_id",
        "label": "Patient",
        "type": "query",
        "datasource": { "type": "influxdb", "uid": "influxdb-vitals" },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(\n  bucket: \"iot_poc\",\n  tag: \"patient_label\",\n  predicate: (r) => r[\"_measurement\"] == \"vitals\",\n  start: -2m\n)",
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "sort": 1,
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "HR (live)",
      "type": "gauge",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 5 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 30,
          "max": 180,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 50 },
              { "color": "yellow", "value": 90 },
              { "color": "red", "value": 100 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "influxdb-vitals" },
          "query": "from(bucket: \"iot_poc\")\n  |> range(start: -15s)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"vitals\")\n  |> filter(fn: (r) => r[\"sensor_name\"] == \"heart_rate\")\n  |> filter(fn: (r) => r[\"patient_label\"] == \"${device_id}\")\n  |> filter(fn: (r) => r[\"_field\"] == \"value\")\n  |> last()",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "SpO₂ (live)",
      "type": "gauge",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 5 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 85,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 93 },
              { "color": "green", "value": 96 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "influxdb-vitals" },
          "query": "from(bucket: \"iot_poc\")\n  |> range(start: -15s)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"vitals\")\n  |> filter(fn: (r) => r[\"sensor_name\"] == \"spo2\")\n  |> filter(fn: (r) => r[\"patient_label\"] == \"${device_id}\")\n  |> filter(fn: (r) => r[\"_field\"] == \"value\")\n  |> last()",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "HRV (live)",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 5 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 20 },
              { "color": "green", "value": 30 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "influxdb-vitals" },
          "query": "from(bucket: \"iot_poc\")\n  |> range(start: -15s)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"vitals\")\n  |> filter(fn: (r) => r[\"sensor_name\"] == \"heart_rate_variability\")\n  |> filter(fn: (r) => r[\"patient_label\"] == \"${device_id}\")\n  |> filter(fn: (r) => r[\"_field\"] == \"value\")\n  |> last()",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Risk Score",
      "type": "stat",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 5 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 30 },
              { "color": "orange", "value": 60 },
              { "color": "red", "value": 80 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "influxdb-vitals" },
          "query": "from(bucket: \"iot_poc\")\n  |> range(start: -2m)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"rule_alerts\")\n  |> filter(fn: (r) => r[\"patient_label\"] == \"${device_id}\")\n  |> filter(fn: (r) => r[\"_field\"] == \"risk_score\")\n  |> last()",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Heart Rate",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "#f87171" },
          "unit": "none",
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 50 },
              { "color": "yellow", "value": 90 },
              { "color": "red", "value": 100 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "influxdb-vitals" },
          "query": "from(bucket: \"iot_poc\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"vitals\")\n  |> filter(fn: (r) => r[\"sensor_name\"] == \"heart_rate\")\n  |> filter(fn: (r) => r[\"patient_label\"] == \"${device_id}\")\n  |> filter(fn: (r) => r[\"_field\"] == \"value\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "SpO₂",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "#38bdf8" },
          "unit": "percent",
          "min": 85,
          "max": 100,
          "custom": { "lineWidth": 2, "fillOpacity": 15 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 93 },
              { "color": "green", "value": 96 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "influxdb-vitals" },
          "query": "from(bucket: \"iot_poc\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"vitals\")\n  |> filter(fn: (r) => r[\"sensor_name\"] == \"spo2\")\n  |> filter(fn: (r) => r[\"patient_label\"] == \"${device_id}\")\n  |> filter(fn: (r) => r[\"_field\"] == \"value\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "HRV",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 13, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "#a78bfa" },
          "unit": "ms",
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 20 },
              { "color": "green", "value": 30 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "influxdb-vitals" },
          "query": "from(bucket: \"iot_poc\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"vitals\")\n  |> filter(fn: (r) => r[\"sensor_name\"] == \"heart_rate_variability\")\n  |> filter(fn: (r) => r[\"patient_label\"] == \"${device_id}\")\n  |> filter(fn: (r) => r[\"_field\"] == \"value\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Alert Timeline",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 13, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": { "lineWidth": 0, "fillOpacity": 80, "drawStyle": "bars" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 30 },
              { "color": "orange", "value": 60 },
              { "color": "red", "value": 80 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "influxdb-vitals" },
          "query": "from(bucket: \"iot_poc\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"rule_alerts\")\n  |> filter(fn: (r) => r[\"patient_label\"] == \"${device_id}\")\n  |> filter(fn: (r) => r[\"_field\"] == \"risk_score\")\n  |> aggregateWindow(every: v.windowPeriod, fn: max, createEmpty: false)",
          "refId": "A"
        }
      ]
    }
  ]
}
